{
  "manifest_version": 3,
  "name": "AI Domain Check",
  "version": "0.0.1",
  "description": "AI 도구 사이트의 공식/미확인/사칭 의심 여부를 즉시 표시하는 크롬 확장프로그램입니다.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://raw.githubusercontent.com/ai-domain-check/ai-domain-check-list/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Domain Check"
  },
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
